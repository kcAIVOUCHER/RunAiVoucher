rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function getUserAgencyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId;
    }
    
    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.email == 'kcarrascosa.comercial@gmail.com' ||
        getUserRole() == 'master' ||
        getUserRole() == 'saas_admin'
      );
    }
    
    function isAgencyAdmin(agencyId) {
      return isAuthenticated() && getUserRole() == 'agency_admin' && getUserAgencyId() == agencyId;
    }
    
    function isAgencyUser(agencyId) {
      return isAuthenticated() && (getUserRole() == 'agency_user' || getUserRole() == 'agency_admin') && getUserAgencyId() == agencyId;
    }

    match /users/{userId} {
      allow read: if isMaster() || request.auth.uid == userId || (isAuthenticated() && getUserAgencyId() == resource.data.agencyId);
      allow write: if isMaster() || request.auth.uid == userId || (isAuthenticated() && getUserRole() == 'agency_admin' && getUserAgencyId() == request.resource.data.agencyId);
    }

    match /agencies/{agencyId} {
      allow read: if isMaster() || isAgencyUser(agencyId);
      allow write: if isMaster();
    }
    
    match /companies/{companyId} {
      allow read, write: if isMaster() || isAgencyUser(resource.data.agencyId) || isAgencyUser(request.resource.data.agencyId);
    }
    
    match /vouchers/{voucherId} {
      allow read, write: if isMaster() || isAgencyUser(resource.data.agencyId) || isAgencyUser(request.resource.data.agencyId);
    }
  }
}
